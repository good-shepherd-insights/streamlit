[Unit]
Description=Streamlit instance %i (streamctl-managed)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dev
WorkingDirectory=/home/dev/streamlit-apps/%i
Environment=STREAMCTL_INSTANCE=%i
# Per-instance values (STREAMCTL_PORT) are written by streamctl create into
# /etc/streamctl/ports/%i - the only per-instance data systemd needs.
EnvironmentFile=/etc/streamctl/ports/%i
ExecStart=/home/dev/streamlit-apps/%i/.venv/bin/streamlit run app.py --server.port=${STREAMCTL_PORT} --server.address=0.0.0.0 --server.headless=true --browser.gatherUsageStats=false
Restart=always
RestartSec=5s
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target